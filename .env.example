# Copy to .env (optional): every value has a localhost default baked into the
# per-app config files (apps/*/src/config, packages/database/src/db.config.ts).
# This file exists to override for other envs.

# Logger mode: pretty output unless "production", silent under "test" (bun
# test sets it automatically).
NODE_ENV=development

# API
PORT=3000
# Threshold routing (ADR 0006): bulk tasks at or under this row count are
# published `light` and run inline in the dispatcher; above it (and every
# catalogue re-index) they get a one-shot runner process.
INLINE_THRESHOLD_ROWS=1000

# Postgres (matches docker/docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bulk_runner
# Size of the pg connection pool of THIS process (api or dispatcher). Spawned
# runners get their own pool (RUNNER_DB_MAX_CONNECTIONS below). The aggregate
# must fit Postgres:
#   api + dispatchers (DB_MAX_CONNECTIONS each)
#     + runners (DISPATCH_MAX_CONCURRENT_RUNNERS x RUNNER_DB_MAX_CONNECTIONS,
#       per dispatcher)
#   <= max_connections (default 100) — the defaults land at 94 with one
#   dispatcher. More dispatchers or runners need a bigger max_connections or
#   a pooler in front.
DB_MAX_CONNECTIONS=20

# Mongo — the business store: `products` and its search projection
# `catalogue_index` (matches docker/docker-compose.yml).
# Only the runner connects.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=bulk_runner

# Dispatcher
DISPATCH_POLL_INTERVAL_MS=1000
# Cap on runner processes one dispatcher keeps alive at once; overflow tasks
# stay pending for later ticks. Sized with the connection budget (see
# DB_MAX_CONNECTIONS).
DISPATCH_MAX_CONCURRENT_RUNNERS=3
# Cap on light tasks run inline in the dispatcher process (threshold routing).
DISPATCH_MAX_CONCURRENT_INLINE=4
# Pg pool size handed to each spawned runner. Must cover the runner's own
# parallelism (RUNNER_CONCURRENCY + 2 — a smaller pool wedges the runner
# under sustained load; the runner refuses to boot below it). See
# DB_MAX_CONNECTIONS for the aggregate budget arithmetic.
RUNNER_DB_MAX_CONNECTIONS=18

# Runner tuning
RUNNER_CONCURRENCY=16
RUNNER_BATCH_SIZE=200
ROW_MAX_ATTEMPTS=3
# Pause before refetching a page that recorded failures (spaces out retries).
ROW_RETRY_BACKOFF_MS=1000
# Drain deadline after SIGTERM/SIGINT: past it, the runner (or the
# dispatcher's inline drain) stops waiting for stuck in-flight rows and
# exits; still-pending rows resume on the next run.
RUNNER_DRAIN_TIMEOUT_MS=30000
# Catalogue re-index: products per page read out of Postgres, and the throttle
# between pages (keeps the SIGTERM window comfortable in the demo).
REINDEX_PAGE_SIZE=1000
REINDEX_PAGE_DELAY_MS=250

# Path to the runner entrypoint the dispatcher spawns (defaults to the
# workspace-relative apps/worker/src/runner/main.ts).
# RUNNER_ENTRYPOINT=

# Liveness & recovery (heartbeat / sweeper / dead-letter — see ADR 0004)
HEARTBEAT_INTERVAL_MS=5000
SWEEP_INTERVAL_MS=10000
STALE_AFTER_MS=30000
TASK_MAX_RESTARTS=3
