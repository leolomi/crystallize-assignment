{
  "name": "bulk-task-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "bun run --filter '*' start",
    "api": "bun run apps/api/src/main.ts",
    "api:dev": "bun --watch run apps/api/src/main.ts",
    "dispatcher": "bun run apps/worker/src/dispatcher/main.ts",
    "dispatcher:dev": "bun --watch run apps/worker/src/dispatcher/main.ts",
    "runner": "bun run apps/worker/src/runner/main.ts",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
    "db:generate": "bun run --cwd packages/database generate",
    "db:migrate": "bun run --cwd packages/database migrate",
    "seed": "bun run scripts/generate-ndjson.ts",
    "test": "bun test",
    "test:integration": "bun test $(find . -name '*.it-spec.ts' -not -path '*/node_modules/*') --preload ./test-utils/global-setup.ts --timeout 30000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.4.6",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "mongodb": "6.21.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-nestjs": "0.1.3",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-pattern": "5.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "pg": "8.20.0",
    "typescript": "5.9.2"
  }
}
