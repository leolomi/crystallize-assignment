# Integration-test env. Loaded (with override) by test-utils/global-setup.ts
# AFTER the test containers are up: $DOCKER_* vars hold the host ports that
# docker compose published dynamically for the bulk-runner-test project.
DB_HOST=localhost
DB_PORT=$DOCKER_POSTGRES_PORT_5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bulk_runner
# Small pool for throwaway containers — and RUNNER_CONCURRENCY sized under it:
# runner.config refuses to boot when the pool cannot cover the runner's own
# parallelism (concurrency + 2).
DB_MAX_CONNECTIONS=5
RUNNER_CONCURRENCY=3
MONGO_HOST=localhost
MONGO_PORT=$DOCKER_MONGO_PORT_27017
MONGO_DB=bulk_runner
